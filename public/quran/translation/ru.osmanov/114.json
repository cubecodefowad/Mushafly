{"name":"An-Nas","index":"114","verse":{"verse_1":"Скажи: \"Ищу убежища у Господа людей,","verse_2":"царя людей,","verse_3":"Бога людей","verse_4":"от зла искусителя, исчезающего [при упоминании имени Аллаха],","verse_5":"подвергающего искушению сердца живых созданий,","verse_6":"как джиннов, так и людей [представляющего]\"."},"count":6}
