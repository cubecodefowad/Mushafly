{"name":"Ash-Sharh","index":"094","verse":{"verse_1":"Miyannaan kuu waasicinin Laabta (ku nuurinin).","verse_2":"Oonaan ka dajinin culayskii.","verse_3":"dhabarka kaa cusleeyay.","verse_4":"Miyaannaan kor yeelin magacaaga (xusiddaada).","verse_5":"Cidhiidhina waxaa ku dhaw fudayd (faraj).","verse_6":"Cidhiidhina waxaa ku dhaw fudayd.","verse_7":"Ee markaad Salaadda dhammayso isku dhib (Samo fal).","verse_8":"Eebana (Khayr) ka rajee."},"count":8}
