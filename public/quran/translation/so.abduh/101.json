{"name":"Al-Qariah","index":"101","verse":{"verse_1":"Qaaricada (qalbiga garaacda).","verse_2":"Qaarica maxay tahay.","verse_3":"Mase taqaannaa Qaarico.","verse_4":"Waa Maalinta Dadku noqon sida Baalallay.","verse_5":"Buuruhuna ay noqon sida Suuf kala firdhay.","verse_6":"Ruuxiise miisaankiisa (fiican) cuslaado.","verse_7":"Wuxuu ku noolaan nolol raalli ah.","verse_8":"Ruuxiise uu fududaado Miisaankiisa (fiican).","verse_9":"Wuxuu u hoydaa (Naarta) Haawiya.","verse_10":"Ma taqaannaa Haawiya.","verse_11":"Waa Naar kulayl daran."},"count":11}
