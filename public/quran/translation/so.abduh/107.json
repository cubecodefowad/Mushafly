{"name":"Al-Ma'un","index":"107","verse":{"verse_1":"Ka warrama kan beenin Abaalmarinta (Qiyaamada).","verse_2":"Kaas xooga Agoonta (xageeda).","verse_3":"Aan kuna boorrinaynin quudinta miskiinka.","verse_4":"Waxaa halaag u sugnaaday kuwa tukan (waa Munaafiqiinta).","verse_5":"Ee haddana halmaansan Salaaddooda.","verse_6":"Dadkana is tusiya.","verse_7":"Una diida alaabta (Laysugu kaalmeeyo)."},"count":7}
