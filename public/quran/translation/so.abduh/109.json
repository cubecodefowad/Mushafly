{"name":"Al-Kafirun","index":"109","verse":{"verse_1":"Waxaad dhahdaa, Gaalooy.","verse_2":"Ma caabudayo waxaad caabudaysaan.","verse_3":"Idinna ma caabudaysaan Eebahaan caabudi.","verse_4":"Mana caabudin waxaad caabuddeen,","verse_5":"Idinkuna (hadda) ma caabudaysaan Eebahaan caabudi.","verse_6":"Idinkana Diintiina yaad leedihiin, Anna Diintaydaan leeyahay."},"count":6}
