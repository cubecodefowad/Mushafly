{"name":"Al-Ma'un","index":"107","verse":{"verse_1":"Je! Umemwona anaye kadhibisha Malipo?","verse_2":"Huyo ndiye anaye msukuma yatima,","verse_3":"Wala hahimizi kumlisha masikini.","verse_4":"Basi, ole wao wanao sali,","verse_5":"Ambao wanapuuza Sala zao;","verse_6":"Ambao wanajionyesha,","verse_7":"Nao huku wanazuia msaada."},"count":7}
