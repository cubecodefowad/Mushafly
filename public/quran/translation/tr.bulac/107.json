{"name":"Al-Ma'un","index":"107","verse":{"verse_1":"Dini yalanlayanı gördün mü?","verse_2":"İşte yetimi itip-kakan;","verse_3":"Yoksulu doyurmayı teşvik etmeyen odur.","verse_4":"İşte (şu) namaz kılanların vay haline,","verse_5":"Ki onlar, namazlarında yanılgıdadırlar,","verse_6":"Onlar gösteriş yapmaktadırlar","verse_7":"Ve ‘ufacık bir yardımı (veya zekatı) da engellemektedirler."},"count":7}
