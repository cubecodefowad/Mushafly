{"name":"Al-Ma'un","index":"107","verse":{"verse_1":"Dini yalanlayanı gördün mü?","verse_2":"İşte o, yetimi itip kakar;","verse_3":"Yoksulu doyurmaya teşvik etmez;","verse_4":"Yazıklar olsun o namaz kılanlara ki,","verse_5":"Onlar namazlarını ciddiye almazlar.","verse_6":"Onlar gösteriş yapanlardır,","verse_7":"Ve hayra da mani olurlar."},"count":7}
