{"name":"Al-Ma'un","index":"107","verse":{"verse_1":"Dini yalanlayanı gördün mü?","verse_2":"İşte o, öksüzü iter, kakar.","verse_3":"Yoksulu doyurmaya önayak olmaz.","verse_4":"Vay haline o namaz kılanların ki,","verse_5":"Kıldıkları namazın değerine aldırış etmezler.","verse_6":"Gösteriş yaparlar onlar,","verse_7":"Ve yardımlığı sakınırlar (zekatı vermezler)."},"count":7}
